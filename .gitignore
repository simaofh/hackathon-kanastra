# Segredos e variáveis de ambiente (15 pts - Logs e Credenciais)
.env
*.env
.env.*
!.env.example

# CSVs pesados do evento (estoque_antecipe.csv etc.), mas permite o lote de exemplo
*.csv
!exemplos/*.csv
*.zip

# Pastas de dados locais (o estoque fica em backend/data/)
data/

# Banco de dados local SQLite (gerado automaticamente em execução)
*.db
*.sqlite3

# Cache do Python e ambientes virtuais
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Logs locais e arquivos de sistema
*.log
logs/
.DS_Store
