# Segredos e variáveis de ambiente (15 pts - Logs e Credenciais)
.env
*.env
.env.*
!.env.example

# Ignora CSVs pesados (estoque_antecipe.csv), mas permite o lote de exemplo
*.csv
!exemplos/*.csv
!exemplos/lote_exemplo.csv
*.zip

# Banco de dados local SQLite (gerado automaticamente em execução)
*.db
*.sqlite3
backend/database.db

# Cache do Python e ambientes virtuais
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Logs locais e arquivos de sistema
*.log
logs/
.DS_Store
